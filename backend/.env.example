# Server Configuration
NODE_ENV=development
PORT=8000

# Frontend
FRONTEND_BASE_URL=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=ecommerce
DB_LOGGING=false

# Database Connection Pool Configuration
# Maximum number of connections in the pool
DB_POOL_MAX=10
# Minimum number of connections in the pool
DB_POOL_MIN=2
# How long a connection can be idle before being closed (milliseconds)
DB_IDLE_TIMEOUT=30000
# How long to wait for a connection before failing (milliseconds)
DB_CONNECTION_TIMEOUT=2000

# Security Configuration
# Number of bcrypt rounds for password hashing (higher = more secure but slower)
# Recommended: 12-14 for production, 10 for development
BCRYPT_ROUNDS=12

# OTP Configuration
# How long OTP tokens are valid (in minutes)
OTP_EXPIRY_MINUTES=15

# User Retention
# How long unverified users are kept before deletion (in hours)
UNVERIFIED_USER_RETENTION_HOURS=24

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@yourapp.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Gemini AI (if using)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI (if using)
OPENAI_API_KEY=your_openai_api_key
